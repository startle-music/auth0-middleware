{
  "name": "startlemusic/auth0-middleware",
  "require": {
    "php": "^8.1",
    "auth0/auth0-php": "^8.18",
    "guzzlehttp/guzzle": "^7.5",
    "symfony/dotenv": "^4.2",
    "firebase/php-jwt": "^6.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
